<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:background="@color/black" android:padding="30dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="HAKODZHAK" android:textColor="@color/red_neon" android:textSize="50sp" android:textStyle="bold"/>
    <EditText android:id="@+id/et_token" android:layout_width="match_parent" android:layout_height="50dp"
        android:layout_marginTop="40dp" android:hint="Bot Token" android:textColor="@color/white" android:backgroundTint="@color/red_neon"/>
    <EditText android:id="@+id/et_chat_id" android:layout_width="match_parent" android:layout_height="50dp"
        android:layout_marginTop="15dp" android:hint="Chat ID" android:textColor="@color/white" android:backgroundTint="@color/red_neon"/>
    <Button android:id="@+id/btn_login" android:layout_width="match_parent" android:layout_height="60dp"
        android:layout_marginTop="30dp" android:backgroundTint="@color/red_dark" android:text="ACTIVATE" android:textColor="@color/white"/>
</LinearLayout>
